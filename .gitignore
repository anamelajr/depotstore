# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/screenshots
/test-results
/playwright-report

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.claude/
.codex/
# brainstorming session artifacts (visual companion)
.superpowers/

# agent tooling byproducts — screenshots, console logs, live-mode state
.playwright-mcp/
.impeccable/

# raw GPT outputs from the CLI drafting script on parse failure
drafts/
